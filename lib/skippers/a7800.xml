<?xml version="1.0"?>
<!--
  Atari 7800 (A78) header skipper definition.

  The A78 format prepends a 128-byte header:
    Bytes 0     : 0x01
    Bytes 1-16  : Magic string "ATARI7800       " (with trailing spaces)
    Bytes 17-48 : Cart title (null-padded)
    Bytes 49-52 : Cart data size (big-endian 32-bit)
    Bytes 53-54 : Cart type
    Bytes 55-57 : Controller types
    Bytes 58-59 : TV type (NTSC/PAL)
    Bytes 60-63 : Reserved
    Bytes 64-99 : Additional metadata
    Bytes 100-127: Padding / reserved
    Byte 128     : 0x41 (ASCII 'A', magic sentinel in some implementations)

  Source: https://7800.8bitdev.org/index.php/A78_Header_Specification
-->
<skipper>
  <name>No-Intro Atari 7800 Header Skipper</name>
  <version>1.0.0</version>
  <author>No-Intro</author>
  <comment>Strips the 128-byte A78 header from Atari 7800 ROM files</comment>
  <rule>
    <description>A78 header (128 bytes) — byte 1 sentinel</description>
    <!-- Byte 0 is 0x01; bytes 1-3 are "ATA" (start of "ATARI7800") -->
    <test offset="0" value="01415441" result="true"/>
    <start method="fixed" offset="128"/>
  </rule>
</skipper>
