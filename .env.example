# Path to SQLite database file
DB_PATH=./data/cartdex.db

# Static API token required on all mutation (POST/PATCH/PUT/DELETE) endpoints.
# Generate with: openssl rand -hex 32
# Must also be set in the browser client (stored in sessionStorage).
# If unset, ALL mutation endpoints return 401 (fail-closed).
CARTDEX_API_TOKEN=

# Default ROM root directory for scan endpoint
ROM_ROOT=/data/roms

# ScreenScraper.fr API credentials (Phase 2 — metadata scraping)
# Register at https://www.screenscraper.fr/membreinscription.php
SCREENSCRAPER_USERNAME=
SCREENSCRAPER_PASSWORD=
# Optional: your registered ScreenScraper developer credentials.
# Register at https://www.screenscraper.fr/webapi2.php to get a devid/devpassword.
# If unset, requests are sent without dev credentials (anonymous dev quota, lower rate limits).
# Do NOT use another developer's credentials here.
SCREENSCRAPER_DEV_ID=
SCREENSCRAPER_DEV_PASSWORD=

# Twitch / IGDB API credentials (Phase 2 — franchise metadata)
# Register at https://dev.twitch.tv/console and enable IGDB at https://api.igdb.com
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
